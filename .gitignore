# Python virtual environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Downloaded model artifacts (hash recorded in config)
models/

# LogAgent-RCA application workspace (uploaded incidents, investigation records)
workspace/

# Secrets and local credentials (web users file holds password hashes; keep it local)
.env
.env.*
users*.json
*.pem
*.key

# Temporary files
*.tmp
*.log.tmp
